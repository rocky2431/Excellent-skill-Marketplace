  },
  "plugins": [
    {
      "name": "ultra-goal",
      "description": "Define an executable goal, its evidence and boundaries, then check explicit completion claims with host hooks.",
      "version": "2.16.0",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/rocky2431/ultra-goal-skill.git",
        "ref": "main",
        "sha": "7210d3a8cb22731e0471380c5de8e0355f5cd5ed",
        "path": "plugins/ultra-goal"
      }
    },
    {
      "name": "agent-delegation",
      "description": "Delegate missions between local agents and inspect their results. Requires the agent-delegate CLI and its ACP dependencies.",
      "version": "0.4.1",
      "source": {
        "source": "url",
        "url": "https://github.com/rocky2431/agent-delegate-skill.git",
        "ref": "main",
        "sha": "0a817535f7a464dfdf6fc7bd32e3dc25b860e0fd"
      },
      "strict": false,
      "skills": [
        "./plugins/agent-delegation/skills"
      ]
    },
    {
      "name": "task-state-with-files",
      "description": "Keep task progress in local files for recovery across sessions and compaction. Hook support depends on the host.",
      "version": "0.4.0",
      "source": {
        "source": "url",
        "url": "https://github.com/rocky2431/plan-with-flie-skill.git",
        "ref": "main",
        "sha": "73d28bc7f70011ace9281d46a7a7f6a6d1925a92"
      },
      "strict": false,
      "skills": [
        "./plugins/task-state-with-files/skills"
      ],
      "hooks": {
        "SessionStart": [
          {
            "matcher": "^(startup|resume|clear|compact)$",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/plugins/task-state-with-files/skills/task-state-with-files/scripts/lifecycle_hook.py\" --host claude",
                "timeout": 10
              }
            ]
          }
        ]
      }
    },
    {
      "name": "agent-harness-design",
      "description": "Design and review agent execution layers, including tools, authority, context recovery and verification.",
      "version": "0.4.0",
      "source": {
        "source": "url",
        "url": "https://github.com/rocky2431/agent-harness-design-skill.git",
        "ref": "main",
        "sha": "88aff97c0b33b9da0a39e9faf773a11eaf7739ae"
      },
      "strict": false,
      "skills": [
        "./plugins/agent-harness-design/skills"
      ]
    },
    {
      "name": "deep-thinking",
      "description": "Clarify ideas, research evidence, examine competing views, and deliver a defensible outcome through human-led inquiry.",
      "version": "0.2.0",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/rocky2431/deepthink-skill.git",
        "ref": "main",
        "sha": "38e322ff8bbbad3c8a38bc6a8c5fc15a631d2401",
        "path": "plugins/deep-thinking"
      }
    }
  ]
}
