    {
      "name": "agent-delegation",
      "description": "Delegate missions between local agents through the host-loaded Skill and inspect their results. Requires installed ACP runtime dependencies.",
      "version": "0.6.4",
      "source": {
        "source": "url",
        "url": "https://github.com/rocky2431/agent-delegate-skill.git",
        "ref": "main",
        "sha": "e85a8f92742ff4c4e68f3889512df7a1709f2619"
      },
      "strict": false,
      "skills": [
        "./plugins/agent-delegation/skills"
      ]
    },
    {
      "name": "task-state-with-files",
      "description": "Keep task progress in local files for recovery across sessions and compaction. Hook support depends on the host.",
      "version": "0.5.0",
      "source": {
        "source": "url",
        "url": "https://github.com/rocky2431/plan-with-flie-skill.git",
        "ref": "main",
        "sha": "5bfe9129faac20bbe42a90ddf9c0954e84561a9f"
      },
      "strict": false,
      "skills": [
        "./plugins/task-state-with-files/skills"
      ],
      "hooks": {
        "SessionStart": [
          {
            "matcher": "^(startup|resume|clear|compact)$",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"${ZCODE_PLUGIN_ROOT}/plugins/task-state-with-files/skills/task-state-with-files/scripts/lifecycle_hook.py\" --host zcode",
                "timeout": 10
              }
            ]
          }
        ]
      }
    },
    {
      "name": "agent-harness-design",
      "description": "Design agent loops and components, with dated model/API adaptation and evidence-based verification.",
